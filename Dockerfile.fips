# SPIRE backend — FIPS-ready image.
#
# The subtlety that makes this correct: a pip-installed `cryptography` wheel
# STATICALLY BUNDLES its own (non-FIPS) OpenSSL, so it can never use the
# validated FIPS module even on a FIPS host. This image therefore builds
# cryptography FROM SOURCE (`--no-binary cryptography`) so it links against the
# SYSTEM OpenSSL — whose FIPS provider on UBI9 is CMVP-validated (cert #4746) —
# and selects the FIPS crypto-policy at build time.
#
# FIPS engages at runtime when EITHER:
#   * the host kernel is in FIPS mode (`fips=1`, production), OR
#   * OPENSSL_FORCE_FIPS_MODE=1 is set (Red Hat: testing/CI only).
# SPIRE verifies this at boot (backend.security_posture.fips_runtime_status) and
# refuses to run under SPIRE_FIPS_MODE=1 if the backend isn't actually in FIPS
# mode — set SPIRE_FIPS_ALLOW_UNVERIFIED=1 only for a config-only smoke test.
#
# Full FIPS 140-3 accreditation of the DEPLOYMENT references the module's CMVP
# certificate; this image is the container half, done to use it correctly.
#
#   docker build -f Dockerfile.fips -t spire-backend:fips .

# registry.access.redhat.com/ubi9/python-312:latest
FROM registry.access.redhat.com/ubi9/python-312@sha256:a6e76c7e9def80d1b736d366c22ba88245d6ec86113b5b2655d52e0ba288b5db

USER 0
WORKDIR /opt/spire

# Build toolchain for compiling cryptography against system OpenSSL, and select
# the FIPS crypto-policy for the image.
RUN dnf install -y gcc openssl-devel cargo && \
    update-crypto-policies --set FIPS && \
    dnf clean all

COPY backend/requirements.txt ./backend-requirements.txt
COPY dataset/requirements.txt ./dataset-requirements.txt
# --no-binary cryptography forces a source build linked to the system OpenSSL
# (validated FIPS provider); the rest install as normal wheels.
RUN pip install --no-cache-dir --no-binary cryptography \
        -r backend-requirements.txt -r dataset-requirements.txt

COPY backend/ ./backend/
COPY dataset/ ./dataset/
RUN mkdir -p /opt/spire/runtime && chown -R 1001:0 /opt/spire

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/spire \
    SPIRE_MODE=full \
    SPIRE_FIPS_MODE=1

VOLUME ["/opt/spire/runtime"]
EXPOSE 8700

# Least privilege — UBI9's default unprivileged user.
USER 1001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8700/api/system/status || exit 1

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8700"]
