# SPIRE frontend env — copy to `.env.local` and edit for local dev.
#
# All vars are read by Vite at build time; `import.meta.env.VITE_*`.

# Build posture: "demo" or "operational".
#
#   demo         — full chrome: Mission Clock, "MARINE MADE", build
#                  version chip, sample badges, threat rings on by
#                  default, walkthrough intros. What the judging
#                  panel saw at MDM 2026.
#   operational  — pilot-ready: chrome trimmed, samples behind +,
#                  threat rings default off, panels collapsed per
#                  role, no demo banners. What CWOs and SSgts use
#                  in sustained pilot operation.
#
# Default if unset: "operational" — pilot deployments are the
# common case; demo nights set this explicitly to "demo" via build
# arg or Fly secret. Set to "demo" for hackathon / judging-panel
# builds and walkthrough screen recordings.
VITE_SPIRE_BUILD=operational

# Backend proxy target. The Vite dev server proxies /api/* here.
# Override to point a fresh dev frontend at a different backend
# port (the launch-it-locally pattern uses 8800).
VITE_BACKEND_TARGET=http://localhost:8000

# Frontend dev port. Override to run a second stack alongside the
# primary one without colliding.
VITE_FRONTEND_PORT=5000
