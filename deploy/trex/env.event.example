# SPIRE event build - enforcing posture.
#
# Copy to deploy/trex/env.event and fill in the marked values, then:
#
#   docker compose -f docker-compose.yml -f docker-compose.event.yml up -d
#
# SPIRE_PROFILE=event makes every setting below load-bearing: the backend
# validates them at import time and refuses to boot if any is missing or
# permissive (backend/security_posture.py::assert_event_profile). That is
# deliberate. An event build that quietly falls back to the demo posture is
# the failure nobody catches until an assessor does.

# ---------------------------------------------------------------------------
# Profile
# ---------------------------------------------------------------------------
SPIRE_PROFILE=event

# ---------------------------------------------------------------------------
# Network posture - deny, do not merely record
# ---------------------------------------------------------------------------
# The egress watchdog wraps socket.getaddrinfo/create_connection. With this
# set, an unapproved connection raises EgressBlocked instead of being audited
# and allowed through.
SPIRE_EGRESS_ENFORCE=1

# No hosted LLM. Tier-B local (Ollama) and the Tier-C deterministic router
# remain available; both are on-box.
SPIRE_LLM_PRIMARY_DISABLE=1

# Feedback stays local. Setting a GitHub token is a boot failure under this
# profile - the drawer writes to the local queue instead.
# SPIRE_GITHUB_TOKEN must remain unset.

# Explicit CORS allowlist. The SPA is served same-origin, so this is normally
# empty; a wildcard is a boot failure.
SPIRE_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# cac = CAC/PIV only. hybrid additionally accepts the PIN path for the
# demo identities; use cac for an assessed run.
SPIRE_AUTH_MODE=cac
# Directory of DoD PKI trust anchors (PEM). Staged by the owner; not in repo.
SPIRE_CAC_TRUST_DIR=/opt/spire/runtime/trust
# skip | crl | ocsp. Field networks are usually offline, so crl with a
# pre-staged list is the realistic setting.
SPIRE_CAC_REVOCATION_MODE=crl

# FILL IN: 32+ random bytes, hex or base64. Sessions are signed with this;
# leaving it unset would mint an ephemeral key that invalidates every session
# on restart.
#   openssl rand -hex 32
SPIRE_SESSION_SECRET=
SPIRE_SESSION_SECURE=1
SPIRE_SESSION_SAMESITE=strict

# ---------------------------------------------------------------------------
# Audit chain
# ---------------------------------------------------------------------------
# FILL IN: Ed25519 signing key. Generate on the box, never in the repo:
#   python -c "from cryptography.hazmat.primitives.asymmetric import ed25519; \
#     k=ed25519.Ed25519PrivateKey.generate(); \
#     open('/opt/spire/runtime/audit-signing.key','wb').write(k.private_bytes_raw())"
SPIRE_AUDIT_SIGNING_KEY_PATH=/opt/spire/runtime/audit-signing.key
SPIRE_AUDIT_PIN_PATH=/opt/spire/runtime/audit-chain.pin

# ---------------------------------------------------------------------------
# At-rest encryption
# ---------------------------------------------------------------------------
# FILL IN. AES-256-GCM, PBKDF2-HMAC-SHA256 (200k) with a per-install salt.
# Without it the SQLite database and audit chain sit on disk in the clear.
SPIRE_DB_PASSPHRASE=

# ---------------------------------------------------------------------------
# Basemap
# ---------------------------------------------------------------------------
# With egress enforced there is no CDN fallback: either a pack is installed
# or the COP renders the explicit no-basemap state. See deploy/tiles/README.md
# for the bake commands.
# SPIRE_TILE_ARCHIVE=/opt/spire/tiles/grafton.pmtiles

# ---------------------------------------------------------------------------
# Node identity (multi-node demo)
# ---------------------------------------------------------------------------
SPIRE_NODE_ID=trex-node-a
# SPIRE_PEER_NODE_ID=trex-node-b
