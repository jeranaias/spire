# SPIRE — Jetson Orin Nano environment template
# ---------------------------------------------------------------------------
# Copy this to the REPO ROOT as `.env` (NOT into deploy/orin/). The backend
# auto-loads <repo>/.env at import time (backend/__init__.py) AND the systemd
# unit references it via EnvironmentFile, so one file covers both paths.
#
#   cp deploy/orin/spire-orin.env.example .env
#
# Real OS environment variables always win over .env values (fill-if-absent),
# so anything you export in the unit or shell overrides what is set here.
# ---------------------------------------------------------------------------

# Air-gap / DDIL mode: never attempt the remote RigRun proxy (Tier-A).
# The LLM router goes straight to the on-device Ollama model. This is the
# correct setting for a disconnected Orin in the field.
SPIRE_LLM_PRIMARY_DISABLE=1

# On-device Ollama endpoint (Tier-B). Ollama listens here by default.
SPIRE_LLM_LOCAL=http://127.0.0.1:11434

# On-device model tag. gemma2:2b (Q4, ~1.7 GB) is the default — Gemma brand,
# GPU-accelerated on the Orin's Ampere GPU, and fits comfortably in 8 GB
# alongside the OS + the SPIRE backend.
#   Faster / smaller : llama3.2:1b
#   Explicit quant   : gemma2:2b-instruct-q4_K_M
#   DO NOT use gemma3:e2b / a ~7 GB model — it will not fit in 8 GB here.
SPIRE_LLM_LOCAL_MODEL=gemma2:2b

# Optional: pin the session-cookie signing secret so logins survive a
# restart. If unset the backend generates an ephemeral secret per boot.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# SPIRE_SESSION_SECRET=replace-with-a-long-random-hex-string
