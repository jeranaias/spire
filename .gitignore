# (see models/README.md and SPIRE_THERMALHAWK_WEIGHTS env var).
/data/thermal_demo/
attached_assets/
datasets/

# Dataset pickle cache (regenerated at boot from dataset/ source mtimes)
.cache/

# Playwright run artifacts
test-results/
