# SPIRE — single-image production build for Fly.io / any Docker host.
#
# Combines the React static bundle + FastAPI backend behind nginx in one
# container. Frontend is served from /usr/share/nginx/html; nginx proxies
# /api/* to the local uvicorn worker. Both processes run under
# supervisord so a crash on either side surfaces as a container restart.
#
# This is the image to deploy publicly. The two-container docker-compose
# layout in the repo root stays for local dev (live-reload friendly).

# ---- Stage 1: Frontend build ---------------------------------------------
FROM node:22-alpine AS frontend
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund --include=optional
COPY frontend/ ./
RUN npm run build

# ---- Stage 2: Python deps ------------------------------------------------
FROM python:3.12-slim AS pydeps
WORKDIR /opt/spire
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
 && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt /tmp/requirements.txt
COPY dataset/requirements.txt /tmp/requirements-dataset.txt
RUN pip install --no-cache-dir --prefix=/install -r /tmp/requirements.txt \
 && pip install --no-cache-dir --prefix=/install -r /tmp/requirements-dataset.txt

# ---- Stage 3: Runtime ----------------------------------------------------
FROM python:3.12-slim
WORKDIR /opt/spire

RUN apt-get update && apt-get install -y --no-install-recommends \
      nginx supervisor curl \
 && rm -rf /var/lib/apt/lists/* \
 && rm -f /etc/nginx/sites-enabled/default

COPY --from=pydeps   /install                 /usr/local
COPY --from=frontend /app/dist                /usr/share/nginx/html
COPY backend/                                  ./backend/
COPY dataset/                                  ./dataset/
COPY deploy/nginx.fly.conf                     /etc/nginx/conf.d/spire.conf
COPY deploy/supervisord.conf                   /etc/supervisor/conf.d/spire.conf

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/opt/spire
ENV SPIRE_MODE=full

VOLUME ["/opt/spire/runtime"]

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/api/system/status >/dev/null || exit 1

CMD ["/usr/bin/supervisord", "--nodaemon", "-c", "/etc/supervisor/supervisord.conf"]
