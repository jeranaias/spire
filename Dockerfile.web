# SPIRE — single-image production build for Fly.io / any Docker host.
#
# Combines the React static bundle + FastAPI backend behind nginx in one
# container. Frontend is served from /usr/share/nginx/html; nginx proxies
# /api/* to the local uvicorn worker. Both processes run under
# supervisord so a crash on either side surfaces as a container restart.
#
# This is the image to deploy publicly. The two-container docker-compose
# layout in the repo root stays for local dev (live-reload friendly).

# ---- Stage 1: Frontend build ---------------------------------------------
# node:22-alpine
FROM node@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS frontend
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund --include=optional
COPY frontend/ ./
RUN npm run build

# ---- Stage 2: Python deps ------------------------------------------------
# python:3.12-slim
FROM python@sha256:3a9d2dd3f18e5c7a9d8de7b3659418a4ab848ccd409fb9e91ef9d7a6a3520ba7 AS pydeps
WORKDIR /opt/spire
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
 && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt /tmp/requirements.txt
COPY dataset/requirements.txt /tmp/requirements-dataset.txt
RUN pip install --no-cache-dir --prefix=/install -r /tmp/requirements.txt \
 && pip install --no-cache-dir --prefix=/install -r /tmp/requirements-dataset.txt

# ---- Stage 3: Runtime ----------------------------------------------------
# python:3.12-slim
FROM python@sha256:3a9d2dd3f18e5c7a9d8de7b3659418a4ab848ccd409fb9e91ef9d7a6a3520ba7
WORKDIR /opt/spire

RUN apt-get update && apt-get install -y --no-install-recommends \
      nginx supervisor curl ca-certificates iptables iproute2 \
 && rm -rf /var/lib/apt/lists/* \
 && rm -f /etc/nginx/sites-enabled/default

# Tailscale — userspace tunnel to Jesse's rig so SPIRE_LLM_PROXY can resolve
# to a tailnet hostname without ever exposing the rig publicly. Pinned to a
# specific Debian release so the apt cache layer is reproducible.
RUN curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg \
        | tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null \
 && curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.tailscale-keyring.list \
        | tee /etc/apt/sources.list.d/tailscale.list >/dev/null \
 && apt-get update \
 && apt-get install -y --no-install-recommends tailscale \
 && rm -rf /var/lib/apt/lists/*

COPY --from=pydeps   /install                 /usr/local
COPY --from=frontend /app/dist                /usr/share/nginx/html
COPY backend/                                  ./backend/
COPY dataset/                                  ./dataset/
# Offline basemap pack. map_tiles.py auto-discovers deploy/tiles/*.pmtiles, so
# baking it here makes the public demo self-host its map (no CartoCDN
# dependency). The archive is gitignored and provided from the local build
# context; if it's absent the COPY still succeeds (README only) and the map
# falls back to the online style.
COPY deploy/tiles/                             ./deploy/tiles/
COPY deploy/nginx.fly.conf                     /etc/nginx/conf.d/spire.conf
COPY deploy/supervisord.conf                   /etc/supervisor/conf.d/spire.conf
COPY deploy/tailscale-up.sh                    /usr/local/bin/tailscale-up.sh
RUN chmod +x /usr/local/bin/tailscale-up.sh

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/opt/spire
ENV SPIRE_MODE=full

VOLUME ["/opt/spire/runtime"]

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/api/system/status >/dev/null || exit 1

CMD ["/usr/bin/supervisord", "--nodaemon", "-c", "/etc/supervisor/supervisord.conf"]
