    "serial_number":   "Replace serial numbers with [SERIAL REDACTED].",
    "tm_reference":    "Replace TM numbers with [TM REFERENCE REDACTED].",
    "fault_component": "Generalize component to family (e.g. 'output shaft' → 'drivetrain').",
